<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Phlix Jade Plugin Coding Standard">
    <description>Coding standard rules for Phlix Jade theme plugin</description>

    <arg name="tab-width" value="4"/>
    <arg name="encoding" value="UTF-8"/>
    <arg name="colors"/>
    <arg name="basepath" value="."/>

    <file>src</file>

    <!-- PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Additional rules -->
    <rule ref="Generic.Classes.OpeningBraceBraceOnNewLine"/>
    <rule ref="Squiz.Functions.MultiLineFunctionDeclaration"/>

    <!-- Exclude generated directories -->
    <exclude-paths>
        <directory>vendor</directory>
        <directory>dev-stubs</directory>
        <directory>.github</directory>
    </exclude-paths>
</ruleset>
