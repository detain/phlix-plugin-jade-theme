{
    "name": "detain/phlix-plugin-jade-theme",
    "description": "Jade theme plugin for Phlix - a deep emerald palette with luminous jade accent tones",
    "type": "project",
    "homepage": "https://github.com/detain/phlix-plugin-jade-theme",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Phlix\\Jade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlix\\Jade\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
